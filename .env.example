# GETSET API. Copy to .env for local development. Production sets these as real environment variables.
# Never commit .env. Everything here is server-only: none of it is sent to browsers.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB (Atlas: Connect -> Drivers -> mongodb+srv://...). Secret: never commit or log it.
# Use a database user limited to this database (readWrite on MONGODB_DB_NAME), and a separate database per environment.
MONGODB_URI=
MONGODB_DB_NAME=getset

# LEGACY, migration source only: the former PostgreSQL database, read by `npm run migrate:pg-to-mongo` and the
# `pg:*` scripts (`npm run pg:dev` starts the local server). The API does not use it. Removed after sign-off.
DATABASE_URL=postgres://getset:getset@localhost:5433/getset

# Public base URLs. API_URL is used to build media and PDF links.
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Signs draft-preview links. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Admin sessions expire this many hours after sign-in.
SESSION_TTL_HOURS=12
# Shared with the customer frontend (same value there) so publishing refreshes cached pages.
REVALIDATE_SECRET=change-me-to-another-long-random-string
# Shared with the admin's server (the same value in the admin's Vercel project). Only requests carrying it may name
# the visitor's address, so admin sign-ins are rate-limited per person, not per admin server. At least 32 characters
# (openssl rand -base64 48). Leave empty locally; in production the API warns at start-up when it is missing.
ADMIN_PROXY_SECRET=
# Where the client's address for rate limits comes from. "cloudflare" on Render (its Cloudflare edge overwrites
# CF-Connecting-IP on every request); "false" anywhere else (the connection's address). X-Forwarded-For is never
# trusted, because callers can write it; "true" is refused at start-up.
TRUST_PROXY=false

# Where new uploads go: "cloudinary" (staging, production) or "local" (writes to STORAGE_LOCAL_DIR; tests, offline work).
# Images already on Cloudinary are served from there either way.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# Cloudinary (Settings -> API Keys). The API key and secret are secrets: server only, never commit or log them.
# CLOUDINARY_FOLDER holds this database's assets (e.g. getset/staging) and is part of every asset URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Currencies. Prices are entered per currency in the admin; nothing is converted.
DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,AED

# Fallback WhatsApp number (digits, international format) for branches without one.
WHATSAPP_NUMBER=971585689114

# Development only: `npm run db:seed` creates this super admin if it does not exist yet. Leave empty in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
