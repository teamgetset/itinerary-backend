{
  "name": "getset-itinerary-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/scripts/test.ts",
    "db:dev": "tsx src/scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:status": "tsx src/scripts/migrate.ts --status",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:verify": "tsx src/scripts/verify-schema.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "admin:create": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
