{
  "name": "getset-itinerary-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/scripts/test.ts",
    "db:indexes": "tsx src/scripts/db-indexes.ts",
    "db:verify": "tsx src/scripts/db-verify.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "search:reindex": "tsx src/scripts/search-reindex.ts",
    "google:business": "tsx src/scripts/google-business.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "admin:credentials": "tsx src/scripts/set-admin-credentials.ts",
    "migrate:pg-to-mongo": "tsx src/scripts/migrate-pg-to-mongo.ts",
    "media:to-cloudinary": "tsx src/scripts/media-to-cloudinary.ts",
    "pg:dev": "tsx src/legacy-postgres/dev-db.ts",
    "pg:generate": "drizzle-kit generate",
    "pg:status": "tsx src/legacy-postgres/migrate.ts --status",
    "pg:migrate": "tsx src/legacy-postgres/migrate.ts",
    "pg:verify": "tsx src/legacy-postgres/verify-schema.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "cloudinary": "2.11.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "mongoose": "9.11.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "mongodb-memory-server": "11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
